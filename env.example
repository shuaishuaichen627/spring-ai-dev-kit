# ==================== 大模型配置 ====================
# Ollama 本地模型（推荐）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI（可选，作为备选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4

# ==================== 数据库配置 ====================
DB_URL=jdbc:postgresql://localhost:5432/spring_ai_dev_kit
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== MCP 工具配置 ====================
# ELK 日志查询
MCP_ELK_ENABLED=true
ELK_BASE_URL=http://localhost:9200
ELK_USERNAME=elastic
ELK_PASSWORD=changeme
ELK_INDEX_PATTERN=logs-*

# Prometheus 监控
MCP_PROMETHEUS_ENABLED=true
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# SQL 报表导出
MCP_SQL_REPORT_ENABLED=true
# 报表数据源（留空则使用主数据源）
REPORT_DB_URL=
REPORT_DB_USERNAME=
REPORT_DB_PASSWORD=
REPORT_EXPORT_DIR=./reports

